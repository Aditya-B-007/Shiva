EMOTION_EMBEDDING_DIM=128
EMOTION_HIDDEN_DIM=512
EMOTION_LATENT_DIM=128
EMOTION_DROPOUT=0.1
EMOTION_CHECKPOINT_PATH=checkpoints/emotion_dynamics.pt
EMOTION_DEVICE=cpu
EMOTION_MODEL_NAME=state-spaces/mamba-130m-hf
EMOTION_FP16=false
EMOTION_BF16=false
MAX_SEQUENCE_LENGTH=4096
SHIVA_SCRATCHPAD_DB=scratchpad.db
SHIVA_MEMORY_DB=memory.db

# Soft Actor-Critic (SAC) Hyperparameters
SAC_STATE_DIM=64
SAC_ACTION_DIM=4
SAC_HIDDEN_DIM=256
SAC_GAMMA=0.99
SAC_TAU=0.005
SAC_ALPHA=0.2
SAC_LR=0.0003

# Constrained Policy Optimization (CPO) Hyperparameters
CPO_STATE_DIM=64
CPO_ACTION_DIM=4
CPO_HIDDEN_DIM=256
CPO_KL_BOUND=0.01
CPO_COST_LIMIT=25.0
CPO_GAMMA=0.99
CPO_GAE_LAMBDA=0.95
CPO_CG_ITERS=10

# Implicit Quantile Networks (IQN) Hyperparameters
IQN_STATE_DIM=64
IQN_ACTION_DIM=4
IQN_HIDDEN_DIM=256
IQN_NUM_QUANTILES=64
IQN_EMBEDDING_DIM=64
IQN_KAPPA=1.0
IQN_GAMMA=0.99
IQN_LR=0.00005

# TD3 + Latent Skill Embedding (z) Hyperparameters
TD3_STATE_DIM=64
TD3_ACTION_DIM=4
TD3_SKILL_DIM=16
TD3_HIDDEN_DIM=256
TD3_POLICY_NOISE=0.2
TD3_NOISE_CLIP=0.5
TD3_POLICY_DELAY=2
TD3_GAMMA=0.99
TD3_TAU=0.005
TD3_LR=0.0003

# Random Network Distillation (RND) Hyperparameters
RND_STATE_DIM=64
RND_OUTPUT_DIM=512
RND_HIDDEN_DIM=256
RND_LR=0.0001
RND_INTRINSIC_SCALE=1.0
