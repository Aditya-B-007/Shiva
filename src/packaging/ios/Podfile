# src/packaging/ios/Podfile
# CocoaPods template linking libraries required for embedding Python runtimes inside Xcode iOS projects.

platform :ios, '14.0'

target 'ShivaApp' do
  use_frameworks!

  # Rubicon-ObjC bridges standard Cocoa framework bindings.
  # This Podfile manages Python runtime dependencies when using Briefcase (BeeWare)
  # or PyTo/Python-Apple-Support templates.
  pod 'Python-Apple-Support', '~> 3.10'
  
  # For iOS, python packages are compiled during target build phase using setup scripts
  # and bundled directly inside the App Bundle Resources directory.
end
